(library
 (name rocqshim)
 (public_name soma-runtime.rocqshim)
 (synopsis "Rocq support for finding and exec-ing subcommands")
 (wrapped false) ; no point repeating the Rocqshim name
 (modules rocqshim)
 (libraries boot unix findlib))

(executable
 (public_name rocq)
 (package soma-runtime)
 (modules rocq)
 (modes exe byte)
 ; we statically link the "small" subcommands instead of having separate binaries
 (libraries rocqshim coqdeplib coqpp coqdoclib rocqwc rocqworkmgr rocqtex rocqmakefile rocqfind))

(install
 (section bin)
 (package soma-runtime)
 (files (rocq.bc as rocq.byte)))

; soma: Soma's command line (soma build FILE is rocq c FILE)
(test
 (name somaMerkleTest)
 (modules somaMerkleTest)
 (enabled_if (= %{os_type} Unix))
 (libraries soma-runtime.clib unix))

(executable
 (name soma)
 (public_name soma)
 (package soma-runtime)
 (modules soma somaTest)
 (libraries rocqshim soma-runtime.boot soma-runtime.clib findlib unix))

; Keep compiler-libs' global modules separate from Rocq's compiler modules.
; This frontend reads OCaml but emits source checked by the ordinary worker.
(executable
 (name somaInsert)
 (modules somaInsert somaInsertCompiler)
 (libraries compiler-libs.common unix))

; Typedtree is compiler-version-specific. A new frontend must never break
; the existing compiler on versions whose typedtree adapter is not implemented.
(rule
 (target somaInsertCompiler.ml)
 (enabled_if (< %{ocaml_version} 5.0))
 (action (copy %{dep:somaInsert414.ml} %{target})))

(rule
 (target somaInsertCompiler.ml)
 (enabled_if (>= %{ocaml_version} 5.0))
 (action (write-file %{target}
   "let main () = prerr_endline \"soma insert: this initial frontend requires Soma built with OCaml 4.14; the OCaml 5 typedtree adapter is not implemented yet.\"; exit 2\n")))

(install
 (section libexec)
 (package soma-runtime)
 (files (somaInsert.exe as soma-insert)))

(executable
 (name rocqnative)
 (modules rocqnative)
 (libraries soma-runtime.kernel)
 (modes exe byte) ; NB byte not installed, just exists for debugger
 (link_flags -linkall))

; Workers
(executable
 (name rocqworker)
 (modules rocqworker)
 (modes exe byte)
 (libraries soma-runtime.toplevel))
 ; Adding -ccopt -flto to links options could be interesting, however,
 ; it doesn't work on Windows

(executable
 (name rocqworker_with_drop)
 (modules rocqworker_with_drop)
 (modes byte)
 (libraries compiler-libs.toplevel soma-runtime.config.byte soma-runtime.toplevel soma-runtime.dev findlib.top))

(install
 (section libexec)
 (package soma-runtime)
 (files
  (rocqworker.exe as rocqworker)
  (rocqworker.bc as rocqworker.byte)
  (rocqworker_with_drop.bc as rocqworker_with_drop)
  (rocqnative.exe as rocqnative)))

(test
 (name somaOwnedNamesTest)
 (modules somaOwnedNamesTest)
 (libraries soma-runtime.toplevel))
