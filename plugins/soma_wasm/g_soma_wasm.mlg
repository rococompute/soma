(* Soma: [Wasm Bind "FILE.wasm".], at the end of FILE.definition
   (toplevel/ccompile.ml): its declarations, tied to the module's exports
   (soma_wasm.ml) *)

{

open Stdarg

}

DECLARE PLUGIN "soma-runtime.plugins.soma_wasm"

VERNAC COMMAND EXTEND SomaWasmBind CLASSIFIED AS SIDEFF
| [ "Wasm" "Bind" string(file) ] -> { Soma_wasm.bind file }
END
