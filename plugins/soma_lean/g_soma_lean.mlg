(* Soma: [Lean Bind "FILE.lean".], at the end of FILE.definition
   (toplevel/ccompile.ml): its theorems, checked by Lean (soma_lean.ml) *)

{

open Stdarg

}

DECLARE PLUGIN "soma-runtime.plugins.soma_lean"

VERNAC COMMAND EXTEND SomaLeanBind CLASSIFIED AS SIDEFF
| [ "Lean" "Bind" string(file) ] -> { Soma_lean.bind file }
END
