(* Soma: in FILE.definition, next to FILE.ml, [OCaml Library "bonsai.web".]
   names a library that FILE.ml uses; [OCaml Bind "FILE.ml".], at the end
   of the file (toplevel/ccompile.ml), ties the declarations to the
   module (soma_ocaml.ml). Next to no module, FILE.definition declares a
   library's module, File: [OCaml Bind Module "File".] *)

{

open Stdarg
open Procq.Prim
open Procq.Constr
let pr_native_signature typ =
  let env = Global.env () in
  Ppconstr.pr_constr_expr ~flags:(Ppconstr.current_flags ()) env (Evd.from_env env) typ


let pr_native_record_field (name,mutable_,typ) =
  Pp.(str (if mutable_ then "mutable " else "") ++ Names.Id.print name ++ str " : " ++ pr_native_signature typ)

let pr_native_record_fields fields =
  Pp.(str "{" ++ prlist_with_sep (fun () -> str "; ") pr_native_record_field fields ++ str "}")

let pr_native_algebraic_case (name,payload) =
  Pp.(qstring name ++ match payload with
    | Soma_ocaml.Arguments [] -> mt ()
    | Soma_ocaml.Arguments args ->
      str " Of [" ++ prlist_with_sep (fun () -> str "; ") pr_native_signature args ++ str "]"
    | Soma_ocaml.Inline_record fields -> spc () ++ pr_native_record_fields fields)

let pr_native_algebraic_member (name,body) =
  Pp.(Names.Id.print name ++ str " := " ++ match body with
    | Soma_ocaml.Record_fields fields -> pr_native_record_fields fields
    | Soma_ocaml.Variant_cases cases ->
      str "[" ++ prlist_with_sep (fun () -> str "; ") pr_native_algebraic_case cases ++ str "]")

}

DECLARE PLUGIN "soma-runtime.plugins.soma_ocaml"

VERNAC COMMAND EXTEND SomaOCamlLibrary CLASSIFIED AS SIDEFF
| [ "OCaml" "Library" ne_string_list(libraries) ] -> { Soma_ocaml.library libraries }
END

VERNAC COMMAND EXTEND SomaOCamlBind CLASSIFIED AS SIDEFF
| [ "OCaml" "Bind" string(file) ] -> { Soma_ocaml.bind file }
| [ "OCaml" "Bind" "Module" string(name) ] -> { Soma_ocaml.bind_library name }
| [ "OCaml" "Bind" "C" string(file) ] -> { Soma_ocaml.bind_c file }
END

VERNAC ARGUMENT EXTEND native_signature PRINTED BY { pr_native_signature }
| [ lconstr(typ) ] -> { typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeType CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Type" ident(name) ":=" string(path) ] -> { Soma_ocaml.native_type name path }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallback CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeValue path) }
| [ "OCaml" "Native" "Get" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeGet field) }
| [ "OCaml" "Native" "Set" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeSet field) }
| [ "OCaml" "Native" "Build" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) "Evaluating" ne_string_list(evaluated) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeBuildEvaluating (fields, evaluated)) }
| [ "OCaml" "Native" "Build" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeBuild fields) }
| [ "OCaml" "Native" "Record" "Factory" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) "Reading" ne_string_list(reading) ] ->
  { Soma_ocaml.native_record_factory name typ fields reading }
| [ "OCaml" "Native" "Record" "Factory" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_record_factory name typ fields [] }
| [ "OCaml" "Native" "Copy" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeCopy fields) }
END

VERNAC ARGUMENT EXTEND native_type_parameter
 PRINTED BY { fun(name,typ)->Pp.(Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeExternal CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(outer) "Composing" string(inner) "After" natural(after) ] ->
 { Soma_ocaml.native_composed_value name typ outer inner after }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) ] ->
 { Soma_ocaml.native_external_constant ~literal name typ path }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_external_constant name typ path }
| [ "OCaml" "Native" "External" "Exception" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_external_exception name path }
| [ "OCaml" "Native" "External" "Type" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" string(path) ] ->
 { Soma_ocaml.native_external_family name params path }
| [ "OCaml" "Native" "External" "Type" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_type ~external_:true name path }
| [ "OCaml" "Native" "External" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) "After" natural(after) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeExternalLiteralCallback (path, literal, after)) }
| [ "OCaml" "Native" "External" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeExternalValue path) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Native" string(native) "Noalloc" ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, Some native, true)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Native" string(native) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, Some native, false)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Noalloc" ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, None, true)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, None, false)) }

END

VERNAC ARGUMENT EXTEND native_record_field
 PRINTED BY { fun (name,mutable_,typ) -> Pp.(str(if mutable_ then "mutable " else "") ++ Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,false,typ }
| [ "mutable" ident(name) ":" native_signature(typ) ] -> { name,true,typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeRecord CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Immutable" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record ~logical:true name fields }
| [ "OCaml" "Native" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record name fields }
END

VERNAC ARGUMENT EXTEND native_algebraic_case
 PRINTED BY { pr_native_algebraic_case }
| [ string(name) "Of" "[" ne_native_signature_list_sep(args, ";") "]" ] ->
  { name, Soma_ocaml.Arguments args }
| [ string(name) "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
  { name, Soma_ocaml.Inline_record fields }
| [ string(name) ] ->
  { name, Soma_ocaml.Arguments [] }
END

VERNAC ARGUMENT EXTEND native_algebraic_member
 PRINTED BY { pr_native_algebraic_member }
| [ ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
  { name, Soma_ocaml.Record_fields fields }
| [ ident(name) ":=" "[" ne_native_algebraic_case_list_sep(cases, ";") "]" ] ->
  { name, Soma_ocaml.Variant_cases cases }
END

VERNAC COMMAND EXTEND SomaOCamlNativeAlgebraic CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Algebraic" ident(name) ":=" "[" ne_native_algebraic_member_list_sep(members, ";") "]"
    "Exceptions" "[" ne_native_algebraic_case_list_sep(exceptions, ";") "]" ] ->
  { Soma_ocaml.native_algebraic ~exceptions name members }
| [ "OCaml" "Native" "Algebraic" ident(name) ":=" "[" ne_native_algebraic_member_list_sep(members, ";") "]" ] ->
  { Soma_ocaml.native_algebraic name members }
END

VERNAC ARGUMENT EXTEND native_variant_case
 PRINTED BY { fun (case_name,typ) -> Pp.(qstring case_name ++ (match typ with None -> mt () | Some t -> str " : " ++ pr_native_signature t)) }
| [ string(tag) ] -> { tag,None }
| [ string(tag) ":" native_signature(typ) ] -> { tag,Some typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeVariant CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant ~parameters:params name cases }
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant name cases }
| [ "OCaml" "Native" "View" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantView None) }
| [ "OCaml" "Native" "Construct" ident(name) ":" native_signature(typ) ":=" string(tag) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantBuild(tag,None)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeConstructor CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Constructor" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) "In" ident(owner) ] ->
  { let path = Soma_ocaml.native_owned_exception owner path in
    Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorBuild(path,arity)) }
| [ "OCaml" "Native" "Case" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) "In" ident(owner) ] ->
  { let path = Soma_ocaml.native_owned_exception owner path in
    Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorCase(path,arity)) }
| [ "OCaml" "Native" "Inline" "Get" ident(name) ":" native_signature(typ) ":=" string(path) string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineGet(path,field)) }
| [ "OCaml" "Native" "Inline" "Set" ident(name) ":" native_signature(typ) ":=" string(path) string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineSet(path,field)) }
| [ "OCaml" "Native" "Inline" "Build" ident(name) ":" native_signature(typ) ":=" string(path) ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineBuild(path,fields)) }
| [ "OCaml" "Native" "Tag" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorTag(path,arity)) }
| [ "OCaml" "Native" "Case" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorCase(path,arity)) }
| [ "OCaml" "Native" "Constructor" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorBuild(path,arity)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallable CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Callable" ident(name) "Optional" ne_ident_list(optional) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_callable ~optional name typ }
| [ "OCaml" "Native" "Callable" ident(name) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_callable name typ }
| [ "OCaml" "Native" "Apply" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableApply None) }
| [ "OCaml" "Native" "Wrap" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableWrap None) }
END
