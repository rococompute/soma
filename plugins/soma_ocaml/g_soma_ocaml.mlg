(* Soma: in FILE.definition, next to FILE.ml, [OCaml Library "bonsai.web".]
   names a library that FILE.ml uses; [OCaml Bind "FILE.ml".], at the end
   of the file (toplevel/ccompile.ml), ties the declarations to the
   module (soma_ocaml.ml). Next to no module, FILE.definition declares a
   library's module, File: [OCaml Bind Module "File".] *)

{

open Stdarg
open Procq.Prim
open Procq.Constr
let pr_native_signature typ =
  let env = Global.env () in
  Ppconstr.pr_constr_expr ~flags:(Ppconstr.current_flags ()) env (Evd.from_env env) typ


let rec pr_native_static_expression = function
  | SomaForeign.StaticArgument index -> Pp.(str "Argument " ++ int index)
  | SomaForeign.StaticValue name -> Pp.(str "Value " ++ str name)
  | SomaForeign.StaticLambda(name,body) ->
    Pp.(str "Function " ++ str name ++ str " [" ++ pr_native_static_expression body ++ str "]")
  | SomaForeign.StaticCall(name,values) ->
    Pp.(str "Call " ++ str name ++ str " [" ++
      prlist_with_sep(fun () -> str "; ")pr_native_static_expression values ++ str "]")

let pr_native_record_field (name,mutable_,typ) =
  Pp.(str (if mutable_ then "mutable " else "") ++ Names.Id.print name ++ str " : " ++ pr_native_signature typ)

let pr_native_record_fields fields =
  Pp.(str "{" ++ prlist_with_sep (fun () -> str "; ") pr_native_record_field fields ++ str "}")

let pr_native_algebraic_case (name,payload) =
  Pp.(qstring name ++ match payload with
    | Soma_ocaml.Arguments [] -> mt ()
    | Soma_ocaml.Arguments args ->
      str " Of [" ++ prlist_with_sep (fun () -> str "; ") pr_native_signature args ++ str "]"
    | Soma_ocaml.Inline_record fields -> spc () ++ pr_native_record_fields fields)

let pr_native_dispatch_payload (name,pattern) =
  Pp.(qstring name ++ match pattern with
    | SomaForeign.Dispatch_arguments _ -> mt ()
    | SomaForeign.Dispatch_fields fields ->
      str " ReadFields [" ++ prlist_with_sep (fun () -> str "; ") qstring fields ++ str "]"
    | SomaForeign.Dispatch_ignore _ -> str " DiscardPayload")

let pr_native_algebraic_member (name,body) =
  Pp.(Names.Id.print name ++ str " := " ++ match body with
    | Soma_ocaml.Record_fields fields -> pr_native_record_fields fields
    | Soma_ocaml.Variant_cases cases ->
      str "[" ++ prlist_with_sep (fun () -> str "; ") pr_native_algebraic_case cases ++ str "]")

}

DECLARE PLUGIN "soma-runtime.plugins.soma_ocaml"

VERNAC COMMAND EXTEND SomaOCamlLibrary CLASSIFIED AS SIDEFF
| [ "OCaml" "Library" ne_string_list(libraries) ] -> { Soma_ocaml.library libraries }
END

VERNAC COMMAND EXTEND SomaOCamlBind CLASSIFIED AS SIDEFF
| [ "OCaml" "Bind" string(file) ] -> { Soma_ocaml.bind file }
| [ "OCaml" "Bind" "Module" string(name) ] -> { Soma_ocaml.bind_library name }
| [ "OCaml" "Bind" "C" string(file) ] -> { Soma_ocaml.bind_c file }
END

VERNAC ARGUMENT EXTEND native_signature PRINTED BY { pr_native_signature }
| [ lconstr(typ) ] -> { typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeReexport CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Reexport" "Group" ident(marker) ":=" reference(source) "Members" "[" ne_string_list_sep(members, ";") "]" ] ->
 { Soma_ocaml.native_algebraic_selection marker source members }
| [ "OCaml" "Native" "Reexport" "Record" ident(marker) ":=" reference(source) "As" string(name) ] ->
 { Soma_ocaml.native_record_reexport marker source name }
| [ "OCaml" "Native" "Reexport" "Source" ident(marker) ":=" reference(source) "As" string(name) "From" string(target) ] ->
 { Soma_ocaml.native_source_type_reexport marker source name target }
| [ "OCaml" "Native" "Reexport" "Type" ident(marker) "As" string(name) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_source_alias_reexport marker typ name }
| [ "OCaml" "Native" "Reexport" "Value" ident(name) ":=" reference(source) ] ->
 { Soma_ocaml.native_value_reexport name source }
| [ "OCaml" "Native" "Reexport" "Binding" ident(name) ":=" reference(source) ] ->
 { Soma_ocaml.native_value_reexport ~binding:true name source }
| [ "OCaml" "Native" "Reexport" "Algebraic" ident(name) ":=" reference(source) "As" string(target) ] ->
 { Soma_ocaml.native_algebraic_reexport name source target }
END

VERNAC COMMAND EXTEND SomaOCamlNativeModule CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Module" "Alias" ident(name) ":=" string(target) ] ->
 { Soma_ocaml.native_module_alias name target }
| [ "OCaml" "Native" "Module" "Include" ident(name) ":=" string(target) ] ->
 { Soma_ocaml.native_module_include name target }
END

VERNAC COMMAND EXTEND SomaOCamlNativeType CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Packed" "Module" "Type" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_packed_module_type name path }
| [ "OCaml" "Native" "Type" ident(name) ":=" string(path) ] -> { Soma_ocaml.native_type name path }
END

VERNAC ARGUMENT EXTEND native_assembly_member
 PRINTED BY { fun(kind,name,source)->Pp.(str kind++spc()++str name++str " := "++Libnames.pr_qualid source) }
| [ "Value" string(name) ":=" reference(source) ] -> { "value",name,source }
| [ "Project" string(pattern) ":=" reference(source) ] -> { "project",pattern,source }
| [ "Exception" string(name) ":=" reference(source) ] -> { "exception",name,source }
| [ "Type" string(name) ":=" reference(source) ] -> { "type",name,source }
| [ "Module" string(name) ":=" reference(source) ] -> { "module",name,source }
END

VERNAC ARGUMENT EXTEND native_public_application
 PRINTED BY { fun(name,source,_)->Pp.(str name++str " := "++Libnames.pr_qualid source) }
| [ "Apply" string(name) ":=" reference(source) "With" "[" ne_reference_list_sep(args, ";") "]" ] ->
 { name,source,args }
END

VERNAC ARGUMENT EXTEND native_functor_parameter
 PRINTED BY { fun(name,signature)->Pp.(str name++str " : "++str signature) }
| [ string(name) ":" string(signature) ] -> { name,signature }
END

VERNAC COMMAND EXTEND SomaOCamlNativeLexicalScope CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Lexical" "Scope" reference(owner) ] ->
 { Soma_ocaml.native_lexical_scope owner [] None }
| [ "OCaml" "Native" "Lexical" "Scope" reference(owner)
    "Functor" string(name) "With" "[" ne_native_functor_parameter_list_sep(parameters, ";") "]" ] ->
 { Soma_ocaml.native_lexical_scope owner [] (Some(name,parameters)) }
| [ "OCaml" "Native" "Lexical" "Scope" reference(owner) "Open" "[" ne_string_list_sep(opens, ";") "]" ] ->
 { Soma_ocaml.native_lexical_scope owner opens None }
| [ "OCaml" "Native" "Lexical" "Scope" reference(owner) "Open" "[" ne_string_list_sep(opens, ";") "]"
    "Functor" string(name) "With" "[" ne_native_functor_parameter_list_sep(parameters, ";") "]" ] ->
 { Soma_ocaml.native_lexical_scope owner opens (Some(name,parameters)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeAssembly CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Assembly" reference(source) "As" string(pattern) ] ->
 { Soma_ocaml.native_assembly source pattern }
| [ "OCaml" "Native" "Static" "Assembly" reference(source) "As" string(name) "With" "[" ne_native_assembly_member_list_sep(exports, ";") "]" ] ->
 { Soma_ocaml.native_static_assembly source name exports }
| [ "OCaml" "Native" "Public" "Types" reference(source) "With" "[" ne_native_assembly_member_list_sep(exports, ";") "]" ] ->
 { Soma_ocaml.native_public_type_equations source exports }
| [ "OCaml" "Native" "Public" "Assembly" reference(source) "With" "[" ne_native_public_application_list_sep(applications, ";") "]" ] ->
 { Soma_ocaml.native_public_assembly source applications }
END

VERNAC COMMAND EXTEND SomaOCamlNativeEnum CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Record" "Alias" ident(name) ":=" reference(source) "As" string(target) ] ->
  { Soma_ocaml.native_record_alias name source target }
| [ "OCaml" "Native" "Variant" "Alias" ident(name) ":=" reference(source) "As" string(target) ] ->
  { Soma_ocaml.native_enum ~variant:true name source target }
| [ "OCaml" "Native" "Enum" ident(name) ":=" reference(source) "As" string(target) ] ->
  { Soma_ocaml.native_enum name source target }
END

VERNAC ARGUMENT EXTEND native_dispatch_payload
 PRINTED BY { pr_native_dispatch_payload }
| [ string(name) "ReadFields" "[" ne_string_list_sep(fields, ";") "]" ] ->
  { name, SomaForeign.Dispatch_fields fields }
| [ string(name) "DiscardPayload" ] -> { name, SomaForeign.Dispatch_ignore false }
| [ string(name) ] -> { name, SomaForeign.Dispatch_arguments 0 }
END

VERNAC ARGUMENT EXTEND native_dispatch_case
 PRINTED BY { fun (name,pattern,keep_receiver) ->
   let payload = pr_native_dispatch_payload (name,pattern) in
   if keep_receiver then Pp.(payload ++ str " KeepReceiver") else payload }
| [ native_dispatch_payload(payload) "KeepReceiver" ] ->
  { let name, pattern = payload in name, pattern, true }
| [ native_dispatch_payload(payload) ] ->
  { let name, pattern = payload in name, pattern, false }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallback CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Get" "Deferred" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_deferred_fields name typ fields }
| [ "OCaml" "Native" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeValue path) }
| [ "OCaml" "Native" "Get" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeGet field) }
| [ "OCaml" "Native" "Get" "AsFunction" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_get_function name typ field }
| [ "OCaml" "Native" "Set" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeSet field) }
| [ "OCaml" "Native" "Set" "AsFunction" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_set_function name typ field }
| [ "OCaml" "Native" "Build" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) "Evaluating" ne_string_list(evaluated) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeBuildEvaluating (fields, evaluated)) }
| [ "OCaml" "Native" "Build" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeBuild fields) }
| [ "OCaml" "Native" "Record" "Factory" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) "Reading" ne_string_list(reading) ] ->
  { Soma_ocaml.native_record_factory name typ fields reading }
| [ "OCaml" "Native" "Record" "Factory" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_record_factory name typ fields [] }
| [ "OCaml" "Native" "Variant" "Dispatch" ident(name) ":" native_signature(typ) ":="
    "[" ne_native_dispatch_case_list_sep(cases, ";") "]" ] ->
  { Soma_ocaml.native_variant_dispatch name typ cases false }
| [ "OCaml" "Native" "Variant" "Dispatch" ident(name) ":" native_signature(typ) ":="
    "[" ne_native_dispatch_case_list_sep(cases, ";") "]" "WithContext" ] ->
  { Soma_ocaml.native_variant_dispatch name typ cases true }
| [ "OCaml" "Native" "Copy" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeCopy fields) }
END

VERNAC ARGUMENT EXTEND native_type_parameter
 PRINTED BY { fun(name,typ)->Pp.(Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,typ }
END

VERNAC ARGUMENT EXTEND native_fixed_boolean
 PRINTED BY { fun value -> Pp.str (string_of_bool value) }
| [ "true" ] -> { true }
| [ "false" ] -> { false }
END

VERNAC ARGUMENT EXTEND native_static_expression
 PRINTED BY { pr_native_static_expression }
| [ "Argument" natural(index) ] -> { SomaForeign.StaticArgument index }
| [ "Value" ident(name) ] -> { SomaForeign.StaticValue(Names.Id.to_string name) }
| [ "Function" ident(name) "[" native_static_expression(body) "]" ] ->
 { SomaForeign.StaticLambda(Names.Id.to_string name,body) }
| [ "Call" ident(name) "[" ne_native_static_expression_list_sep(values, ";") "]" ] ->
 { SomaForeign.StaticCall(Names.Id.to_string name,values) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeStatic CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Published" "Value" ident(name) ":" native_signature(typ) ":=" reference(source) ] ->
 { Soma_ocaml.native_published_value name typ source }
| [ "OCaml" "Native" "Static" "Initialize" ident(name) ":" native_signature(typ) ":=" reference(target) "With" "[" ne_reference_list_sep(values, ";") "]" ] ->
 { Soma_ocaml.native_static_initialization name typ target values }
| [ "OCaml" "Native" "Static" "Data" ident(name) ":" native_signature(typ) ":=" reference(recipe) "With" "[" ne_reference_list_sep(leaves, ";") "]" ] ->
 { Soma_ocaml.native_static_data name typ recipe leaves }
| [ "OCaml" "Native" "Static" "Data" ident(name) ":" native_signature(typ) ":=" reference(recipe) ] ->
 { Soma_ocaml.native_static_data name typ recipe [] }
| [ "OCaml" "Native" "Static" "Invoke" ident(name) ":" native_signature(typ) ":=" ident(target) "With" "[" ne_native_static_expression_list_sep(values, ";") "]" "AtFullApplication" ] ->
 { Soma_ocaml.native_static_invocation name typ target values }
| [ "OCaml" "Native" "Static" "Apply" ident(name) ":" native_signature(typ) ":=" ident(target) "With" "[" ne_ident_list_sep(bound, ";") "]" "AtFullApplication" ] ->
 { Soma_ocaml.native_static_application name typ target bound }
| [ "OCaml" "Native" "Static" "Compose" "Scope" ident(name) ":" native_signature(typ) ":=" ident(outer) "With" ident(inner) ] ->
 { Soma_ocaml.native_static_composition_scope name typ outer inner }
| [ "OCaml" "Native" "Static" "Compose" ident(name) ":" native_signature(typ) ":=" ident(outer) "With" ident(inner) ] ->
 { Soma_ocaml.native_static_function name typ false outer inner }
| [ "OCaml" "Native" "Static" "Prefix" ident(name) ":" native_signature(typ) ":=" ident(outer) "With" ident(inner) ] ->
 { Soma_ocaml.native_static_function name typ true outer inner }
END

VERNAC COMMAND EXTEND SomaOCamlNativeExternal CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "External" "Bound" "Function" ident(name) ":" native_signature(typ) ":=" string(path) "Binding" string(label) native_fixed_boolean(value) "Using" native_signature(schema) ] ->
 { Soma_ocaml.native_bound_boolean_function name typ path schema label value }
| [ "OCaml" "Native" "External" "Defaulted" "Function" ident(name) ":" native_signature(typ) ":=" string(path) "Using" native_signature(schema) ] ->
 { Soma_ocaml.native_defaulted_function name typ path schema }
| [ "OCaml" "Native" "External" "Eta" "Function" ident(name) ":" native_signature(typ) ":=" string(path) "Using" native_signature(schema) ] ->
 { Soma_ocaml.native_defaulted_function ~eta:true name typ path schema }
| [ "OCaml" "Native" "External" "Thunk" "Factory" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) ] ->
 { Soma_ocaml.native_external_thunk_factory name typ path literal }
| [ "OCaml" "Native" "Assertion" "Function" ident(name) ":" native_signature(typ) ":=" natural(line) natural(column) ] ->
 { Soma_ocaml.native_getter name typ (SomaForeign.NativeAssertionFunction(line,column)) }
| [ "OCaml" "Native" "Assertion" "Function" "Factory" ident(name) ":" native_signature(typ) ":=" natural(line) natural(column) ] ->
 { Soma_ocaml.native_assertion_function_factory name typ line column }
| [ "OCaml" "Native" "Assertion" "Factory" ident(name) ":" native_signature(typ) ":=" natural(line) natural(column) ] ->
 { Soma_ocaml.native_assertion_factory name typ line column }
| [ "OCaml" "Native" "Float" ident(name) ":" native_signature(typ) ":=" string(literal) ] ->
 { Soma_ocaml.native_float_constant name typ literal }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(outer) "Composing" string(inner) "After" natural(after) "Transforming" string(transform) "At" natural(position) ] ->
  { Soma_ocaml.native_transformed_composition name typ outer inner after transform position }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(outer) "Composing" string(inner) "After" natural(after) ] ->
 { Soma_ocaml.native_composed_value name typ outer inner after }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) "After" natural(after) "AtFullApplication" ] ->
 { Soma_ocaml.native_inserted_literal_function name typ path literal after }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) "Reading" ne_string_list(fields) "AtFullApplication" ] ->
 { Soma_ocaml.native_fields_function name typ path fields }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) "AtFullApplication" ] ->
 { Soma_ocaml.native_literal_function name typ path literal }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) ] ->
 { Soma_ocaml.native_external_constant ~literal name typ path }
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_external_constant name typ path }
| [ "OCaml" "Native" "External" "Field" "Value" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_external_constant ~field_value:true name typ path }
| [ "OCaml" "Native" "External" "Exception" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_external_exception name path }
| [ "OCaml" "Native" "External" "Type" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" string(path) ] ->
 { Soma_ocaml.native_external_family name params path }
| [ "OCaml" "Native" "External" "Type" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_type ~external_:true name path }
| [ "OCaml" "Native" "External" "Callback" ident(name) "Optional" ne_ident_list(optional) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_callback ~optional name typ (SomaForeign.NativeExternalValue path) }
| [ "OCaml" "Native" "External" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) "With" string(literal) "After" natural(after) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeExternalLiteralCallback (path, literal, after)) }
| [ "OCaml" "Native" "External" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeExternalValue path) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Native" string(native) "Noalloc" ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, Some native, true)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Native" string(native) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, Some native, false)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) "Noalloc" ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, None, true)) }
| [ "OCaml" "Native" "Primitive" ident(name) ":" native_signature(typ) ":=" string(byte) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativePrimitive (byte, None, false)) }

END

VERNAC ARGUMENT EXTEND native_record_field
 PRINTED BY { fun (name,mutable_,typ) -> Pp.(str(if mutable_ then "mutable " else "") ++ Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,false,typ }
| [ "mutable" ident(name) ":" native_signature(typ) ] -> { name,true,typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeRecord CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Immutable" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record ~logical:true name fields }
| [ "OCaml" "Native" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record name fields }
END

VERNAC ARGUMENT EXTEND native_algebraic_case
 PRINTED BY { pr_native_algebraic_case }
| [ string(name) "Of" "[" ne_native_signature_list_sep(args, ";") "]" ] ->
  { name, Soma_ocaml.Arguments args }
| [ string(name) "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
  { name, Soma_ocaml.Inline_record fields }
| [ string(name) ] ->
  { name, Soma_ocaml.Arguments [] }
END

VERNAC ARGUMENT EXTEND native_algebraic_member
 PRINTED BY { pr_native_algebraic_member }
| [ ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
  { name, Soma_ocaml.Record_fields fields }
| [ ident(name) ":=" "[" ne_native_algebraic_case_list_sep(cases, ";") "]" ] ->
  { name, Soma_ocaml.Variant_cases cases }
END

VERNAC COMMAND EXTEND SomaOCamlNativeAlgebraic CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Algebraic" ident(name) ":=" "[" ne_native_algebraic_member_list_sep(members, ";") "]"
    "Exceptions" "[" ne_native_algebraic_case_list_sep(exceptions, ";") "]" ] ->
  { Soma_ocaml.native_algebraic ~exceptions name members }
| [ "OCaml" "Native" "Algebraic" ident(name) ":=" "[" ne_native_algebraic_member_list_sep(members, ";") "]" ] ->
  { Soma_ocaml.native_algebraic name members }
END

VERNAC ARGUMENT EXTEND native_variant_case
 PRINTED BY { fun (case_name,typ) -> Pp.(qstring case_name ++ (match typ with None -> mt () | Some t -> str " : " ++ pr_native_signature t)) }
| [ string(tag) ] -> { tag,None }
| [ string(tag) ":" native_signature(typ) ] -> { tag,Some typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeVariant CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Open" "Polymorphic" "Variant" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant ~parameters:params ~open_row:true name cases }
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant ~parameters:params name cases }
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant name cases }
| [ "OCaml" "Native" "View" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantView None) }
| [ "OCaml" "Native" "Construct" "Function" ident(name) ":" native_signature(typ) ":=" string(tag) ] ->
 { Soma_ocaml.native_variant_function name typ tag }
| [ "OCaml" "Native" "Construct" "Factory" ident(name) ":" native_signature(typ) ":=" string(tag) ] ->
 { Soma_ocaml.native_variant_factory name typ tag }
| [ "OCaml" "Native" "Construct" ident(name) ":" native_signature(typ) ":=" string(tag) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantBuild(tag,None)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeConstructor CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Constructor" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) "In" ident(owner) ] ->
  { let path = Soma_ocaml.native_owned_exception owner path in
    Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorBuild(path,arity)) }
| [ "OCaml" "Native" "Case" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) "In" ident(owner) ] ->
  { let path = Soma_ocaml.native_owned_exception owner path in
    Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorCase(path,arity)) }
| [ "OCaml" "Native" "Inline" "Get" ident(name) ":" native_signature(typ) ":=" string(path) string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineGet(path,field)) }
| [ "OCaml" "Native" "Inline" "Set" ident(name) ":" native_signature(typ) ":=" string(path) string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineSet(path,field)) }
| [ "OCaml" "Native" "Inline" "Build" ident(name) ":" native_signature(typ) ":=" string(path) ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeInlineBuild(path,fields)) }
| [ "OCaml" "Native" "Tag" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorTag(path,arity)) }
| [ "OCaml" "Native" "Case" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorCase(path,arity)) }
| [ "OCaml" "Native" "Constructor" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorBuild(path,arity)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallable CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Callable" ident(name) "Optional" ne_ident_list(optional) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_callable ~optional name typ }
| [ "OCaml" "Native" "Callable" ident(name) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_callable name typ }
| [ "OCaml" "Native" "Apply" "AsFunction" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_apply_function name typ }
| [ "OCaml" "Native" "Apply" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableApply None) }
| [ "OCaml" "Native" "Wrap" "AtFullApplication" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableWrapFull None) }
| [ "OCaml" "Native" "Wrap" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableWrap None) }
END
