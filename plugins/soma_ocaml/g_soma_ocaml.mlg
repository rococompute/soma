(* Soma: in FILE.definition, next to FILE.ml, [OCaml Library "bonsai.web".]
   names a library that FILE.ml uses; [OCaml Bind "FILE.ml".], at the end
   of the file (toplevel/ccompile.ml), ties the declarations to the
   module (soma_ocaml.ml). Next to no module, FILE.definition declares a
   library's module, File: [OCaml Bind Module "File".] *)

{

open Stdarg
open Procq.Prim
open Procq.Constr
let pr_native_signature typ =
  let env = Global.env () in
  Ppconstr.pr_constr_expr ~flags:(Ppconstr.current_flags ()) env (Evd.from_env env) typ

}

DECLARE PLUGIN "soma-runtime.plugins.soma_ocaml"

VERNAC COMMAND EXTEND SomaOCamlLibrary CLASSIFIED AS SIDEFF
| [ "OCaml" "Library" ne_string_list(libraries) ] -> { Soma_ocaml.library libraries }
END

VERNAC COMMAND EXTEND SomaOCamlBind CLASSIFIED AS SIDEFF
| [ "OCaml" "Bind" string(file) ] -> { Soma_ocaml.bind file }
| [ "OCaml" "Bind" "Module" string(name) ] -> { Soma_ocaml.bind_library name }
| [ "OCaml" "Bind" "C" string(file) ] -> { Soma_ocaml.bind_c file }
END

VERNAC ARGUMENT EXTEND native_signature PRINTED BY { pr_native_signature }
| [ lconstr(typ) ] -> { typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeType CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Type" ident(name) ":=" string(path) ] -> { Soma_ocaml.native_type name path }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallback CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeValue path) }
| [ "OCaml" "Native" "Get" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeGet field) }
| [ "OCaml" "Native" "Set" ident(name) ":" native_signature(typ) ":=" string(field) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeSet field) }
| [ "OCaml" "Native" "Build" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeBuild fields) }
| [ "OCaml" "Native" "Copy" ident(name) ":" native_signature(typ) ":=" ne_string_list(fields) ] ->
  { Soma_ocaml.native_callback name typ (SomaForeign.NativeCopy fields) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeExternal CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "External" "Value" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_external_constant name typ path }
| [ "OCaml" "Native" "External" "Type" ident(name) ":=" string(path) ] ->
 { Soma_ocaml.native_type ~external_:true name path }
| [ "OCaml" "Native" "External" "Callback" ident(name) ":" native_signature(typ) ":=" string(path) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeExternalValue path) }
END

VERNAC ARGUMENT EXTEND native_record_field
 PRINTED BY { fun (name,mutable_,typ) -> Pp.(str(if mutable_ then "mutable " else "") ++ Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,false,typ }
| [ "mutable" ident(name) ":" native_signature(typ) ] -> { name,true,typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeRecord CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Immutable" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record ~logical:true name fields }
| [ "OCaml" "Native" "Record" ident(name) ":=" "{" ne_native_record_field_list_sep(fields, ";") "}" ] ->
 { Soma_ocaml.native_record name fields }
END

VERNAC ARGUMENT EXTEND native_variant_case
 PRINTED BY { fun (case_name,typ) -> Pp.(qstring case_name ++ (match typ with None -> mt () | Some t -> str " : " ++ pr_native_signature t)) }
| [ string(tag) ] -> { tag,None }
| [ string(tag) ":" native_signature(typ) ] -> { tag,Some typ }
END

VERNAC ARGUMENT EXTEND native_type_parameter
 PRINTED BY { fun(name,typ)->Pp.(Names.Id.print name ++ str " : " ++ pr_native_signature typ) }
| [ ident(name) ":" native_signature(typ) ] -> { name,typ }
END

VERNAC COMMAND EXTEND SomaOCamlNativeVariant CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) "(" ne_native_type_parameter_list_sep(params, ";") ")" ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant ~parameters:params name cases }
| [ "OCaml" "Native" "Polymorphic" "Variant" ident(name) ":=" "[" ne_native_variant_case_list_sep(cases, ";") "]" ] ->
 { Soma_ocaml.native_variant name cases }
| [ "OCaml" "Native" "View" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantView None) }
| [ "OCaml" "Native" "Construct" ident(name) ":" native_signature(typ) ":=" string(tag) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeVariantBuild(tag,None)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeConstructor CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Tag" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorTag(path,arity)) }
| [ "OCaml" "Native" "Case" ident(name) ":" native_signature(typ) ":=" string(path) natural(arity) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeConstructorCase(path,arity)) }
END

VERNAC COMMAND EXTEND SomaOCamlNativeCallable CLASSIFIED AS SIDEFF
| [ "OCaml" "Native" "Callable" ident(name) ":=" native_signature(typ) ] ->
 { Soma_ocaml.native_callable name typ }
| [ "OCaml" "Native" "Apply" ident(name) ":" native_signature(typ) ] ->
 { Soma_ocaml.native_callback name typ (SomaForeign.NativeCallableApply None) }
END
