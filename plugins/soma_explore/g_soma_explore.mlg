(* Soma: [Explore model.] (theories/Soma/Explore.v), a bounded search of a
   state machine (soma_explore.ml) *)

{

open Stdarg

}

DECLARE PLUGIN "soma-runtime.plugins.soma_explore"

VERNAC COMMAND EXTEND SomaExplore CLASSIFIED AS QUERY
| [ "Explore" constr(c) ] -> { Soma_explore.explore c }
END
