(library
 (name coqargs)
 (public_name soma-runtime.coqargs)
 (synopsis "Rocq command line argument parsing")
 (modules coqargs)
 (wrapped false)
 ; don't depend on soma-runtime.lib -> impossible to imperatively set random flags
 (libraries soma-runtime.config soma-runtime.boot soma-runtime.clib soma-runtime.lib))

(library
 (name sysinit)
 (public_name soma-runtime.sysinit)
 (synopsis "Rocq's initialization")
 (wrapped false)
 (modules :standard \ coqargs)
 (libraries soma-runtime.boot soma-runtime.vernac coqargs findlib))
