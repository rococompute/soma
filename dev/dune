(library
 (name dev)
 (public_name soma-runtime.dev)
 (synopsis "Rocq's Debug Printers")
 (wrapped false)
 (modules top_printers vm_printers)
 ; NB currently we have no "install_printer" using ltac2,
 ; but we still want to load_printer ltac2
 ; so that its genarg printers are present in the debugger's printer process
 (libraries soma-runtime.vernac soma-runtime.plugins.ltac soma-runtime.plugins.ltac2))

(library
 (name debugger_support)
 (public_name soma-runtime.debugger_support)
 (synopsis "Rocq Support for ocamldebug")
 (wrapped false)
 (modules debugger_support)
 (libraries soma-runtime.dev))

(rule
  (targets dune-dbg)
  (deps
    dune-dbg.in
    ../checker/coqchk.bc
    ../topbin/rocqworker.bc
    ../topbin/rocqnative.bc
    ; We require all the OCaml libs to be in place and searchable
    ; by OCamlfind, this is a bit of a hack but until Dune gets
    ; proper ocamldebug support we have to live with that.
    %{lib:soma-runtime.config:config.cma}
    %{lib:soma-runtime.clib:clib.cma}
    %{lib:soma-runtime.lib:lib.cma}
    %{lib:soma-runtime.kernel:kernel.cma}
    %{lib:soma-runtime.vm:coqrun.cma}
    %{lib:soma-runtime.vm:../../stublibs/dllcoqrun_stubs.so}
    %{lib:soma-runtime.library:library.cma}
    %{lib:soma-runtime.engine:engine.cma}
    %{lib:soma-runtime.pretyping:pretyping.cma}
    %{lib:soma-runtime.gramlib:gramlib.cma}
    %{lib:soma-runtime.interp:interp.cma}
    %{lib:soma-runtime.proofs:proofs.cma}
    %{lib:soma-runtime.parsing:parsing.cma}
    %{lib:soma-runtime.printing:printing.cma}
    %{lib:soma-runtime.tactics:tactics.cma}
    %{lib:soma-runtime.vernac:vernac.cma}
    %{lib:soma-runtime.plugins.ltac:ltac_plugin.cma}
    %{lib:soma-runtime.plugins.ltac2:ltac2_plugin.cma}
    %{lib:soma-runtime.dev:dev.cma}
    %{lib:soma-runtime.debugger_support:debugger_support.cmi}
    %{lib:soma-runtime.debugger_support:debugger_support.cma}
    %{lib:soma-runtime.debugger_support:../META})
  (action (copy dune-dbg.in dune-dbg)))

(alias
 (name ml_toplevel_files)
 (deps (glob_files ml_toplevel/**)))

(install
 (section lib)
 (package soma-runtime)
 (files (glob_files (ml_toplevel/** with_prefix dev/ml_toplevel))))
