succ_dyn = fun x : Dyn => cast Dyn nat x + 1
     : Dyn -> nat

Arguments succ_dyn x
apply3 =
fun g : Dyn => cast Dyn nat (cast Dyn (Dyn -> Dyn) g (cast nat Dyn 3))
     : Dyn -> nat

Arguments apply3 g
delta = fun x : Dyn => cast Dyn (Dyn -> Dyn) x x
     : Dyn -> Dyn

Arguments delta x
omega = delta (cast (Dyn -> Dyn) Dyn delta)
     : Dyn
