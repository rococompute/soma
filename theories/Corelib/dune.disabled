; For now we use coq_dune to generate the rules here
(rocq.theory
 (name Corelib)
 (package soma-core)
 (synopsis "Rocq's Core Library")
 ; Uncomment this to have dune compile native files in release mode
 ; (mode native)
 (boot)
 (plugins
   soma-runtime.plugins.ltac
   soma-runtime.plugins.tauto

   soma-runtime.plugins.cc
   soma-runtime.plugins.firstorder

   soma-runtime.plugins.number_string_notation

   soma-runtime.plugins.btauto
   soma-runtime.plugins.rtauto

   soma-runtime.plugins.ring
   soma-runtime.plugins.nsatz

   soma-runtime.plugins.zify
   soma-runtime.plugins.micromega

   soma-runtime.plugins.funind

   soma-runtime.plugins.ssreflect
   soma-runtime.plugins.derive))

(include_subdirs qualified)

(documentation
 (package soma-core))
