; Careful with bug https://github.com/ocaml/odoc/issues/148
;
; If we don't pack checker we will have a problem here due to
; duplicate module names in the whole build.
(library
 (name coq_checklib)
 (public_name soma-runtime.checklib)
 (synopsis "Rocq's Standalone Proof Checker")
 (modules :standard \ rocqchk votour)
 (wrapped true)
 (libraries soma-runtime.boot soma-runtime.kernel))

(executable
 (name rocqchk)
 (public_name rocqchk)
 (modes exe byte)
 (package soma-runtime)
 (modules rocqchk)
 (flags :standard -open Coq_checklib)
 (libraries coq_checklib))

(executable
 (name votour)
 (public_name votour)
 (package soma-runtime)
 (modules votour)
 (flags :standard -open Coq_checklib)
 (libraries coq_checklib))

