(* Soma: [Macro name args := body.] and [Reader name text := body.], in
   .ext files (vernac/somaMacro.ml) *)

DECLARE GLOBAL PLUGIN

{

open Stdarg

let lconstr = Procq.Constr.lconstr

}

VERNAC ARGUMENT EXTEND macro_body PRINTED BY { Ppconstr.pr_lconstr_expr ~flags:(Ppconstr.current_flags ()) env sigma }
| [ lconstr(c) ] -> { c }
END

VERNAC COMMAND EXTEND SomaMacro CLASSIFIED AS SIDEFF
| [ "Macro" identref(name) identref(args) ":=" macro_body(body) ] ->
  { SomaMacro.define ?loc:name.CAst.loc ~name ~args body }
END

(* Soma: [Reader name text := body.], in .ext files *)
VERNAC COMMAND EXTEND SomaReader CLASSIFIED AS SIDEFF
| [ "Reader" identref(name) identref(text) ":=" macro_body(body) ] ->
  { SomaMacro.define_reader ?loc:name.CAst.loc ~name ~text body }
END
