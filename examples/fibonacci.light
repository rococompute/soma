(** Fibonacci numbers, three ways. Types are inferred from the patterns
    ([0], [Succ m]) and from [+]. *)

(** The textbook definition. [Succ] means "one more than", so
    [Succ (Succ m as p)] matches a number of at least 2 and names its two
    predecessors [p] (n - 1) and [m] (n - 2). Every recursive call must be
    on a smaller piece of [n] taken apart by the [match], which is what
    guarantees that the function terminates. *)
Recursive fib n :=
  match n with
  | 0 => 0
  | 1 => 1
  | Succ (Succ m as p) => fib p + fib m
  end.

Check fib.
(* fib : nat -> nat *)

fib 10.                (* 55 *)

(** Linear time: carry the last two numbers along. *)
Recursive fib_loop n a b :=
  match n with
  | 0 => a
  | Succ m => fib_loop m b (a + b)
  end.

Definition fast_fib n := fib_loop n 0 1.

fast_fib 20.           (* 6765 *)

(** A [nat] is stored in unary, [Succ (Succ ... 0)], so large results are
    slow and can overflow the stack. Stdlib's [N] is binary: [n] still
    counts the steps, but the numbers added are [N]s. [%N] in the output
    marks an [N] literal. *)
From Stdlib Require Import NArith.

Recursive big_fib_loop (n : nat) (a b : N) : N :=
  match n with
  | 0 => a
  | Succ m => big_fib_loop m b (a + b)
  end.

Definition big_fib n := big_fib_loop n 0 1.

big_fib 100.           (* 354224848179261915075%N *)
