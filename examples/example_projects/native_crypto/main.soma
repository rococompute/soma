(** Digestif's C backend is linked into this image, with no WASM or host
    service. Only public SHA-256 test messages are used. *)
Import Sandbox digestif native_helpers.

main : io unit :=
  print (label "native " (unwrap (wrap "OCaml"))) ;;
  print (to_string (twice next 40)) ;;
  print (SHA256.to_hex (SHA256.digest_string "")) ;;
  print (SHA256.to_hex (SHA256.digest_string "abc")) ;;
  print "native crypto checks passed".
