(** The answer to each request: the counter's page at the start of the
    request (web/request.soma), which sets the cookie [count] to it, so
    that coming back to [/] goes on from there; a count that is not
    accepted is [400 Bad Request], and an address that is not the page,
    [404 Not Found]. *)
Import Sandbox.
Import pages.pages.
Import pages.counter.
Import web.request.

(** a response, with its status and its headers *)
response (status : string) (headers : list string) (content_type body : string) : string :=
  ("HTTP/1.1 " ++ status ++ crlf ++
   "Content-Type: " ++ content_type ++ crlf ++
   String.concat "" (List.map (fun h => h ++ crlf) headers) ++
   "Content-Length: " ++ to_string (String.length body) ++ crlf ++
   "Connection: close" ++ crlf ++ crlf ++ body)%str.

(** the page at [n], which the cookie remembers *)
page (n : N) : string :=
  response "200 OK" [("Set-Cookie: count=" ++ to_string n ++ "; Path=/; SameSite=Lax")%str]
    "text/html; charset=utf-8"
    ("<!DOCTYPE html>" ++ render (view (counter n) (init (counter n))))%str.

(** a count that is not accepted; when the cookie had it, the cookie is
    cleared, and else left as it is *)
bad_count (value : string) (from_cookie : bool) : string :=
  response "400 Bad Request" (if from_cookie then ["Set-Cookie: count=; Path=/; Max-Age=0"] else [])
    "text/plain; charset=utf-8"
    ("A count is a whole number, 0 or more, such as 0 or 42, and not " ++ value ++ ".")%str.

not_found : string := response "404 Not Found" [] "text/plain; charset=utf-8" "Not found.".

(** the counter's address: [/], and [/?...] with a query *)
is_page (path : string) : bool := String.eqb path "/" || String.prefix "/?" path.

respond (request : string) : string :=
  if is_page (path_of request) then
    match start_of request with
    | Start n => page n
    | Rejected value =>
      (* the address comes first: without a count there, it was the cookie's *)
      bad_count value (match url_count request with None => true | Some _ => false end)
    end
  else not_found.

answer (request : string) : io string :=
  print ("request for " ++ path_of request) ;;
  ret (respond request).
