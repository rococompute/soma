From Soma Require Native.
From Corelib Require Import PrimFloat.
OCaml Native External Value arguments : Native.vector string := "Sys.argv".
OCaml Native External Value clock_cell : reference (Native.callback unit PrimFloat.float) := "Fixture.now".
