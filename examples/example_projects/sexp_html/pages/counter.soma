(** A counter, in the language of pages/ (pages/pages.lang): a page with a
    +1 button. Its state is the count of pages.lang, from 0, and its only
    action is [Increment]: this file gives the view, nothing else. *)

counter := app count
  (html
    (head
      (title "Counter")
      (meta (attrs (charset "utf-8"))))
    (body
      (div (attrs (class "counter") (data_id "main"))
        (h1 "Count: " count)
        (button (attrs (on click Increment)) "+1")))).
