(** A counter's view, as an s-expression with events: its buttons produce
    actions, as [onClick] does in JSX. *)

Inductive action := Increment | Reset.

view (count : nat) : element action :=
  let shown := to_string count in
  sexp
    (div (attrs (class "counter") (data_id "main"))
      (p "Count: " shown)
      (button (attrs (on click Increment)) "+")
      (button (attrs (on click Reset)) "Reset")).
