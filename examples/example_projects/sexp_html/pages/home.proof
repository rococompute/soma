(** What is proved about the home page *)

(** The home page in JSX notation *)
Definition home_jsx : element unit :=
  <html>
    <head> <title> "Soma" </title> <meta charset="utf-8" /> </head>
    <body>
      <div class="page">
        <h1> "Hello world" </h1>
        {Greeting "Soma"}
        <hr />
        <p> "Written in " "1" " s-expression." </p>
      </div>
    </body>
  </html>.

(** The s-expression is the same element as the JSX. *)
Theorem home_is_jsx : home = home_jsx.
Proof.
  We conclude that home = home_jsx.
Qed.

(** [Greeting] escapes any name: no name can make markup of its own. *)
Theorem greeting_html : forall name,
  render (Greeting name) = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
Proof.
  Take name : string.
  We need to show that
    ("<p>" ++ ("Hello, " ++ escape name ++ "!") ++ "</p>")%str
    = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
  By append_assoc, we conclude that
    ("<p>" ++ ("Hello, " ++ escape name ++ "!") ++ "</p>")%str
    = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
Qed.
