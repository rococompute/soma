(** The home page, as an s-expression. [sexp] is the macro of
    pages/pages.lang, the rules of pages/: this file has it without
    importing anything. *)

(** A component, called as [(Greeting "Soma")] *)
Greeting (name : string) : element unit := sexp (p "Hello, " name "!").

home : element unit := sexp
  (html
    (head
      (title "Soma")
      (meta (attrs (charset "utf-8"))))
    (body
      (div (attrs (class "page"))
        (h1 "Hello world")
        (Greeting "Soma")
        (hr _)
        (p "Written in " 1 " s-expression.")))).
