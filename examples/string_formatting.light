(** Building a string from a value of unknown type. [name : Dyn] is
    accepted where a [string] is expected; Lightlang inserts a cast that
    is checked when [greet] runs. *)

Definition greet (name : Dyn) : string := append "Hello, " name.

Print greet.
(* greet = fun name : Dyn => append "Hello, " (cast Dyn string name) *)

greet "world".
(* = "Hello, world" *)

(** A [nat] is not a [string]: the cast fails at run time and [name]
    becomes [raise], the runtime type error. A [string] is a list of
    characters, so [append] copies "Hello, " and leaves [raise] as its
    tail; such a string is printed with its [String] and [Ascii]
    constructors instead of quotes. *)
greet 42.
(* = String.String (Ascii.Ascii ...) ( ... (String.String ... raise)) *)
