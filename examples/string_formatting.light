(** Building strings. [greet]'s parameter has no annotation: its type is
    inferred from [append] as [string]. *)

From Stdlib Require Import DecimalString.

Definition greet name := append "Hello, " name.

(** A [nat] in decimal, with Stdlib's DecimalString. *)
Definition to_string (n : nat) : string := NilZero.string_of_uint (Nat.to_uint n).

Check greet.
(* greet : string -> string *)

greet "world".         (* "Hello, world" *)
greet (to_string 42).  (* "Hello, 42" *)

(** The type of [name] is known, so a [nat] is rejected when the program
    is checked, not when it runs: there is no [Any] to defer the check.
    [Fail] expects the command to be rejected. *)
Fail greet 42.         (* nat and string differ *)
