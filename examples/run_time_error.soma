(** A type error caught while the program runs. compile_time_error.soma is
    the same mistake caught before it runs.

    [greet_any]'s parameter is declared [Any], so any value is accepted
    when the program is checked, and [name] is cast to [string] when it
    runs. *)
greet_any (name : Any) := append "Hello, " name.

greet_any "world".     (* "Hello, world" *)
greet_any 42.          (* "Hello, " ++ raise
                          Run-time error: expected a string, but got 42 : nat. *)
