(** A MirageOS unikernel. Requiring [Mirage] makes the program one:
    [rocq c examples/mirage_hello.light] also builds
    [examples/mirage_hello.hvt], which runs on Apple Silicon with
        solo5-hvt -- examples/mirage_hello.hvt
    (see the Mirage section of GRADUAL.md for the setup).

    [main : io unit] is what the unikernel does. An [io] is a description
    of actions, built like any other value; the image carries them out in
    order. [a ;; b] is [a], then [b]. *)
Require Import Mirage.

greet name := append "Hello, " (to_string name).

(** A recursive [io]: print [n], wait a second, count down from [n - 1]. *)
Recursive countdown n :=
  match n with
  | 0 => print "lift off"
  | Succ m => print (to_string n) ;; sleep 1 ;; countdown m
  end.

main : io unit :=
  print (greet "world") ;;
  print (greet [1, 2, 3]) ;;
  countdown 3.

(* console:
   Hello, world
   Hello, [1,2,3]
   3
   2
   1
   lift off *)
