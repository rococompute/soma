(** What is proved about the components of reason_components.light. This
    file is read after reason_components.light, in its environment: the
    components and the Reason library are in scope, JSX included. Building
    or running reason_components.light checks it, and fails if a proof does
    not hold. *)

(** [Greeting] renders a paragraph with the name, escaped, for every name:
    no name can produce markup of its own. *)
Theorem greeting_html : forall name,
  render (A := unit) (<Greeting name=name />) = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
Proof.
  intros name. simpl. rewrite !append_assoc. reflexivity.
Qed.

(** [Plus_one]'s prop is [Any], but given a number [n], it shows [n + 1]:
    the casts in and out of [Any] give [n] back. *)
Theorem plus_one_html : forall n : nat,
  render (A := unit) (<Plus_one count=n />) =
  ("<span>" ++ escape (to_string (n + 1)) ++ "</span>")%str.
Proof.
  intros n. simpl. reflexivity.
Qed.

(** the list renders as its two items *)
Theorem items_html : render (A := unit) items = "<li>one</li><li>two</li>".
Proof. reflexivity. Qed.
