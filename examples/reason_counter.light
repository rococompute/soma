(** A counter app with a proven property. As in ReasonReact's
    [useReducer], the app has a state (the count), actions that change it
    ([step]), and a [view] of it whose buttons produce actions. Nothing
    below has a type annotation: [step : action -> nat -> nat] and the
    others are inferred. The types are only in what is proved: whatever
    buttons are clicked, in whatever order, the count stays at most
    [limit], and [Reset] always brings it back to 0.

    If this file compiles, both are proved: [state_after counter clicks],
    the count after any list of [clicks], is checked for all of them, not
    tested on some.

        light run examples/reason_counter.light *)
Require Import Reason.

Inductive action := Increment | Decrement | Reset.

limit := 10.

(** what an action does to the count; [Increment] does nothing at [limit] *)
step action count :=
  match action with
  | Increment => if count <? limit then count + 1 else count
  | Decrement => count - 1
  | Reset => 0
  end.

(** a component whose prop is untyped, as one written in JavaScript might
    be: [(text : string)] reads it as a string, checked when the page is
    built. The proofs below are about the count, so it does not matter. *)
Label {text : Any} := <h2> (text : string) </h2>.

view count :=
  <div className="counter">
    <Label text="A counter" />
    <p> "Count: " {to_string count} </p>
    <button onClick=Increment> "+" </button>
    <button onClick=Decrement> "-" </button>
    <button onClick=Reset> "reset" </button>
  </div>.

(** the app: it starts at 0 *)
counter := make_app 0 step view.

(** each action keeps the count at most [limit] *)
Lemma step_within_limit : forall action count, count <= limit -> step action count <= limit.
Proof.
  intros [] count H; unfold step; try lia.
  destruct (Nat.ltb_spec count limit); lia.
Qed.

(** so does any list of actions, from any count at most [limit] *)
Lemma replay_within_limit : forall clicks count,
  count <= limit -> replay step count clicks <= limit.
Proof.
  induction clicks as [|action clicks IH]; intros count H; cbn [replay List.fold_left] in *.
  - exact H.
  - apply IH, step_within_limit, H.
Qed.

(** Whatever the clicks, the count stays at most [limit]. *)
Theorem count_within_limit : forall clicks, state_after counter clicks <= limit.
Proof.
  intros clicks. exact (replay_within_limit clicks 0 ltac:(unfold limit; lia)).
Qed.

(** Whatever the clicks before it, [Reset] brings the count back to 0. *)
Theorem reset_clears : forall clicks, state_after counter (clicks ++ [Reset]) = 0.
Proof.
  intros clicks. unfold state_after, replay. rewrite List.fold_left_app. reflexivity.
Qed.

(** the page after clicking +, +, +, - *)
render (view (state_after counter [Increment, Increment, Increment, Decrement])).
