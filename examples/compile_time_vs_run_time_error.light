(** When types are checked: before the program runs, or, for [Any], while
    it runs. *)

(** [name] is passed to [append], so its type is inferred as [string], and
    a [nat] is rejected when the program is checked. *)
greet name := append "Hello, " name.

greet "world".         (* "Hello, world" *)
Fail greet 42.         (* nat and string differ *)

(** [greet_any]'s parameter is declared [Any], so any value is accepted
    when the program is checked, and [name] is cast to [string] when it
    runs. *)
greet_any (name : Any) := append "Hello, " name.

greet_any "world".     (* "Hello, world" *)
greet_any 42.          (* "Hello, " followed by raise: 42 is not a string *)
