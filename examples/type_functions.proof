(** What is proved about type_functions.soma. This file is read after
    type_functions.soma, in its environment: [g], [j] and the rest are in
    scope, without importing anything. Building or running
    type_functions.soma checks it, and fails if a proof does not hold. *)

(** [j] cannot be given an odd number: whatever [x : g Int] is, the number
    in it is not an odd [n], as [x] holds a proof that its number is
    even. *)
Theorem j_rejects_odd : forall (n : nat) (x : g Int),
  Nat.odd n = true -> proj1_sig x <> n.
Proof.
  intros n [m m_even] n_odd; cbn; intros ->.
  unfold Nat.odd in n_odd. rewrite m_even in n_odd. discriminate.
Qed.

(** For a number above 1, [j] returns a larger one: [n * n > n]. *)
Theorem j_grows : forall x : g Int, proj1_sig x > 1 -> j x > proj1_sig x.
Proof.
  intros [n n_even] n_gt_1; cbn in *.
  unfold j; cbn. nia.
Qed.
