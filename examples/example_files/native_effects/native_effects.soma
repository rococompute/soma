(** Native library entry points. No Sandbox import and no project interpreter. *)
Require Import Soma.Native.

Definition update (get : unit -> nat) (put : nat -> unit) : entry nat :=
 Export (Invoke get (fun old => Invoke (fun _ => put (S old)) (fun _ => Return old))).

Definition sequenced (get : unit -> nat) (put : nat -> unit) : entry nat :=
 Export (Bind (Invoke get Return) (fun old => Invoke (fun _ => put old) (fun _ => Return old))).

Definition promised (value : string) : entry (promise string) := Export (Promise_return value).
Definition result_alias (value : result string string) : entry (result string string) := Export (Return value).
Definition result_length (value : result string string) : entry nat := Export (Return
 (match value with Ok text => String.length text | Error _ => 0 end)).

Definition count (initial : nat) (value : string) : entry string := Export (Loop
 (fun left => Return (match left with 0 => Finish value | S next => Continue next end)) initial).

Definition protected (body : unit -> nat) (recover : exception_value -> nat) : entry nat :=
 Export (Protect (Invoke body Return) (fun error => Invoke (fun _ => recover error) Return)).

Definition rethrow (error : exception_value) : entry nat := Export (Throw error).

Definition mapped (read : unit -> promise string) (render : string -> nat) : entry (promise nat) :=
 Export (Promise_map read (fun value => Export (Invoke (fun _ => render value) Return))).

Definition bound (read : unit -> promise string) (next : string -> promise nat) : entry (promise nat) :=
 Export (Promise_bind read (fun value => Export (Invoke (fun _ => next value) Return))).

Definition caught (body : unit -> promise nat) (recover : exception_value -> promise nat) : entry (promise nat) :=
 Export (Promise_catch (fun _ => Export (Invoke body Return))
   (fun error => Export (Invoke (fun _ => recover error) Return))).

Definition finalized (body : unit -> promise nat) (cleanup : unit -> promise unit) : entry (promise nat) :=
 Export (Promise_finally (fun _ => Export (Invoke body Return))
   (fun _ => Export (Invoke cleanup Return))).

Definition folded (step : nat -> string -> promise nat) (initial : nat) (items : list string) : entry (promise nat) :=
 Export (Promise_fold (fun before item => Export (Invoke (fun _ => step before item) Return)) initial items).

Definition mapped_list (step : string -> promise nat) (items : list string) : entry (promise (list nat)) :=
 Export (Promise_map_s (fun word => Export (Invoke (fun _ => step word) Return)) items).
Definition failed (error : exception_value) : entry (promise nat) := Export (Promise_fail error).
Definition make_reference (value : nat) : entry (reference nat) := Export (New_reference value).
Definition change_reference (location : reference nat) (change : nat -> nat) : entry nat := Export
 (Bind (Read_reference location) (fun before => Invoke (fun _ => change before) (fun after =>
 Bind (Write_reference location after) (fun _ => Return before)))).
Definition asserted (file : string) (line column : nat) : entry nat := Export (Assert_failure file line column).
Definition ordinary_entry (body : unit -> nat) : entry nat := ordinary (Export (Invoke body Return)).

Definition filtered (predicate : string -> bool) (items : list string) : entry (list string) := Export (Filter predicate items).

(** Returned callbacks remain opaque handles in the logic. Native callers
    see ordinary functions whose physical identity also names their self. *)
Definition owned_callback (read : unit -> promise nat) : entry (callback unit (promise nat)) := Export
 (New_callback (fun self _ => Promise_map read (fun value => Export
  (Invoke (fun _ => opaque self) (fun _ => Return value))))).
Definition called_callback (body : callback nat nat) (value : nat) : entry nat := Export (Call_callback body value).

(** Native storage exposes the original ABI types, not copied model values. *)
Definition make_vector (items : list string) := Export (Vector_of_list items).
Definition vector_snapshot (items : vector string) := Export (Vector_to_list items).
Definition vector_size (items : vector string) := Export (Vector_length items).
Definition get_vector (items : vector string) (index : PrimInt63.int) := Export (Vector_get items index).
Definition set_vector (items : vector string) (index : PrimInt63.int) (value : string) := Export (Vector_set items index value).
Definition make_builder (capacity : PrimInt63.int) := Export (New_text_buffer capacity).
Definition append_builder (buffer : text_buffer) (text : string) := Export (Text_buffer_append buffer text).
Definition char_builder (buffer : text_buffer) (character : Ascii.ascii) := Export (Text_buffer_char buffer character).
Definition contents_builder (buffer : text_buffer) := Export (Text_buffer_contents buffer).
Definition make_table (capacity : PrimInt63.int) : entry (table string string) := Export (New_table capacity).
Definition has_table (items : table string string) (key : string) := Export (Table_mem items key).
Definition find_table (items : table string string) (key : string) := Export (Table_find items key).
Definition lookup_table (items : table string string) (key : string) := Export (Table_find_opt items key).
Definition put_table (items : table string string) (key value : string) := Export (Table_replace items key value).
Definition remove_table (items : table string string) (key : string) := Export (Table_remove items key).
Definition mapped_text (mapper : callback Ascii.ascii Ascii.ascii) (text : string) := Export (String_map mapper text).
Definition get_byte (text : string) (index : PrimInt63.int) := Export (String_get text index).
Definition get_byte_nat (text : string) (index : nat) := Export (String_get_nat text index).
Definition format_word (value : PrimInt63.int) := Export (Word_decimal value).
Definition format_nat (value : nat) := Export (Nat_decimal value).
Definition basename (path : string) := Export (Path_basename path).
Definition dirname (path : string) := Export (Path_dirname path).
Definition concat_path (directory file : string) := Export (Path_concat directory file).
Definition applied (body : unit -> promise nat) := Export (Promise_apply (fun _ => Export (Invoke body Return))).

(** Compose Source-defined callbacks without a pure evaluator for entries.
    Invocation still happens before the native map/bind exception scope. *)
Definition mapped_callback (source : callback unit (promise string)) (render : string -> nat) := Export
 (Promise_map_entry (fun _ => Export (Call_callback source tt))
 (fun value => Export (Invoke (fun _ => render value) Return))).
Definition bound_callback (source : callback unit (promise string)) (next : string -> promise nat) := Export
 (Promise_bind_entry (fun _ => Export (Call_callback source tt))
 (fun value => Export (Invoke (fun _ => next value) Return))).

(** Deferred library effects preserve Lazy's exact promise/exn cache. *)
Definition deferred_read (read : unit -> promise string) := Export
 (New_deferred (fun _ => Export (Invoke read Return))).
Definition deferred_force (body : deferred string) := Export (Force_deferred body).
Definition substring (text : string) (offset count : PrimInt63.int) := Export (String_substring text offset count).
Definition missing_value (_ : unit) : entry nat := Export Raise_not_found.
Definition text_size (text : string) := Export (String_length text).
Definition mapped_vector {A B : Type} (mapper : callback A B) (items : vector A) := Export (Vector_map mapper items).
Definition owned_mapped_vector (mapper : string -> string) (items : vector string) := Export
 (Bind (New_callback (fun _ value => Invoke (fun _ => mapper value) Return))
  (fun owned => Vector_map owned items)).
Definition consumed_list_step (observe : list string -> unit) (state : list string) :=
 Invoke (fun _ => observe state) (fun _ => Return
   (match state with nil => Finish tt | _ :: tail => Continue tail end)).
Definition consumed_list (observe : list string -> unit) (items : list string) := Export
 (Loop (consumed_list_step observe) items).
Definition consumed_list_after (observe : list string -> unit) (after : unit -> unit) (items : list string) := Export
 (loop_then (consumed_list_step observe) items (fun _ => Invoke after Return)).
Definition finished_loop {S A B : Type} (step : S -> progress S A) (initial : S) (next : A -> B) := Export
 (loop_then (fun state => Invoke (fun _ => step state) Return) initial
   (fun value => Invoke (fun _ => next value) Return)).

(** The primitive combines already-started promises. Source controls any
    initializer evaluation order before reaching the actual Lwt.both call. *)
Definition paired_promises {A B : Type} (left : promise A) (right : promise B) :=
 Export (Promise_both left right).
Definition started_pair {A B : Type} (left : unit -> promise A) (right : unit -> promise B) := Export
 (Invoke right (fun right_pending => Invoke left (fun left_pending => Promise_both left_pending right_pending))).
Definition started_nested_pair {A B C : Type} (left : unit -> promise A) (middle : unit -> promise B) (right : unit -> promise C) := Export
 (Invoke right (fun right_pending => Invoke middle (fun middle_pending => Invoke left (fun left_pending =>
 Bind (Promise_both left_pending middle_pending) (fun pair_pending => Promise_both pair_pending right_pending))))).
Definition failure_value {A : Type} (message : string) : entry A := Export (Raise_failure message).
Definition literal_failure_value (_ : unit) : entry unit := Export (Raise_failure "tl").

(** Structural recursion over differently typed promise bodies stays typed;
    no recursive native evaluator or result cast is part of the Source API. *)
Inductive family_action (A : Type) :=
 | Family_value (value : A)
 | Family_text (body : family_action string) (next : string -> A)
 | Family_unit (body : family_action unit) (next : unit -> A)
 | Family_count (body : family_action nat) (next : nat -> A)
 | Family_source (source : unit -> promise A).
Arguments Family_value {A} value. Arguments Family_text {A} body next.
Arguments Family_unit {A} body next. Arguments Family_count {A} body next.
Arguments Family_source {A} source.
Fixpoint family_program {A : Type} (action : family_action A) : program (promise A) := match action with
 | Family_value value => Promise_return value
 | Family_text body next => Promise_map_entry (fun _ => Export (family_program body)) (fun value => Export (Return (next value)))
 | Family_unit body next => Promise_map_entry (fun _ => Export (family_program body)) (fun value => Export (Return (next value)))
 | Family_count body next => Promise_map_entry (fun _ => Export (family_program body)) (fun value => Export (Return (next value)))
 | Family_source source => Invoke source Return end.
Definition family_run {A : Type} (action : family_action A) := Export (family_program action).

Definition main := (update,sequenced,promised,result_alias,result_length,count,protected,rethrow,mapped,bound,caught,finalized,folded,
 mapped_list,failed,make_reference,change_reference,asserted,ordinary_entry,filtered,owned_callback,called_callback,make_vector,vector_snapshot,vector_size,get_vector,set_vector,make_builder,append_builder,char_builder,contents_builder,make_table,has_table,find_table,lookup_table,put_table,remove_table,mapped_text,get_byte,get_byte_nat,format_word,format_nat,basename,dirname,concat_path,applied,mapped_callback,bound_callback,deferred_read,deferred_force,substring,missing_value,text_size,@mapped_vector,owned_mapped_vector,consumed_list,consumed_list_after,@finished_loop,@paired_promises,@started_pair,@started_nested_pair,@failure_value,literal_failure_value,@family_run).
