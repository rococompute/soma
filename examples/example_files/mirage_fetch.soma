(** A unikernel that fetches a page over HTTP from the address it is given,
    prints it, and exits: 0 when it got a reply, 1 when there was none
    (and says why), 2 without an address or with one that is not an IP
    address. With mirage_http_server.hvt running at
    192.168.105.46 (it prints its address):

        soma run examples/example_files/mirage_fetch.soma -- --arg=192.168.105.46

    [args] are the [--arg=...] given to the image, in order. *)
Require Import Sandbox.

main : io unit :=
  a <- args ;;
  match a with
  | [address] =>
    print ("fetching http://" ++ address ++ ":8080/hello") ;;
    reply <- fetch address 8080 (http_get "/hello") ;;
    match reply with
    | Reply page => print page
    | Refused => print "the connection was refused: nothing listens there" ;; exit 1
    | TimedOut => print "nothing answered within 10 seconds" ;; exit 1
    | BadAddress => print (address ++ " is not an IP address") ;; exit 2
    end
  | _ => print "usage: --arg=ADDRESS" ;; exit 2
  end.
