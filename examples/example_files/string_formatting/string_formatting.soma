(** Building strings. [to_string] turns a string, number, boolean, or a list
    of these into a [string].

    [greet]'s parameter has no annotation and nothing fixes its type, so it
    becomes a type parameter: [greet] takes any [name] that has a
    [to_string], and the [to_string] to use is chosen at each call, when
    the program is checked. *)

greet name := append "Hello, " (to_string name).

greet "world".          (* "Hello, world" *)
greet 42.               (* "Hello, 42" *)
greet [1, 2, 3].        (* "Hello, [1,2,3]" *)
greet ["a", "b", "c"].  (* "Hello, [a,b,c]" *)

(** A type with no [to_string] is rejected when the program is checked.
    [Fail] expects the command to be rejected. *)
Fail greet tt.          (* Could not find an instance for "Show unit" *)
