(** What is proved about the components of reason_components.soma. This
    file is read after reason_components.soma, in its environment: the
    components and the JSX library are in scope, JSX included. Building
    or running reason_components.soma checks it, and fails if a proof does
    not hold. *)

(** [Greeting] renders a paragraph with the name, escaped, for every name:
    no name can produce markup of its own. The paragraph is its text
    between [<p>] and [</p>], and the texts are the same once appended in
    one order ([append_assoc]). *)
Theorem greeting_html : forall name,
  render (A := unit) (<Greeting name=name />) = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
Proof.
  Take name : string.
  We need to show that
    ("<p>" ++ ("Hello, " ++ escape name ++ "!") ++ "</p>")%str
    = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
  By append_assoc, we conclude that
    ("<p>" ++ ("Hello, " ++ escape name ++ "!") ++ "</p>")%str
    = ("<p>Hello, " ++ escape name ++ "!</p>")%str.
Qed.

(** [Plus_one]'s prop is [Any], but given a number [n], it shows [n + 1]:
    the casts in and out of [Any] give [n] back, so rendering computes to
    the same text. *)
Theorem plus_one_html : forall n : nat,
  render (A := unit) (<Plus_one count=n />) =
  ("<span>" ++ escape (to_string (n + 1)) ++ "</span>")%str.
Proof.
  Take n : nat.
  We conclude that
    render (A := unit) (<Plus_one count=n />)
    = ("<span>" ++ escape (to_string (n + 1)) ++ "</span>")%str.
Qed.

(** the list renders as its two items *)
Theorem items_html : render (A := unit) items = "<li>one</li><li>two</li>".
Proof.
  We conclude that render (A := unit) items = "<li>one</li><li>two</li>".
Qed.
